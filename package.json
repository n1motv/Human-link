{
  "name": "human-link",
  "version": "3.0.0",
  "private": true,
  "description": "Human Link — gestion RH : Node.js + MongoDB + React",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "instances": "node scripts/instances.mjs",
    "secrets:gen": "node scripts/gen-secrets.mjs",
    "ship": "node scripts/ship-instance.mjs",
    "setup": "npm run install:all && npm --prefix server run setup",
    "dev:db": "npm --prefix server run dev:db",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "seed:demo": "npm --prefix server run seed -- --demo",
    "seed:demo:reset": "npm --prefix server run seed -- --demo --reset-demo",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server test && npm --prefix client test && npm --prefix client run i18n:check && npm --prefix client run typecheck",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "sbom": "node scripts/sbom.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
