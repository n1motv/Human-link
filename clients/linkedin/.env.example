# Configuration SECRÈTE de l'instance « linkedin » : à copier en .env dans ce dossier (jamais versionné).
# Test local sans Docker :  npm run instances -- init linkedin   (génère ce fichier avec des clés uniques)
# Déploiement Docker       :  cp .env.example .env, puis remplir les clés (voir docs/INSTANCES.md)

NODE_ENV=production
APP_URL=https://rh.linkedin.example.com

JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY=
PSEUDONYM_KEY=

# E-mail sortant (activation de compte, mot de passe oublié, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RH LinkedIn <rh@linkedin.example.com>"

# Compte administrateur initial (seed)
ADMIN_EMAIL=admin@linkedin.example.com
ADMIN_PASSWORD=

# Assistant RH optionnel (API compatible OpenAI /v1/completions : LM Studio, Ollama, vLLM...)
LLM_API_URL=
LLM_MODEL=
