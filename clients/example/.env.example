# Configuration SECRÈTE d'un client déployé avec Docker (copier en .env dans ce dossier ; jamais versionné).
# Les clés se génèrent avec :  cd server && npm run gen:keys

NODE_ENV=production
APP_URL=https://rh.entreprise.com

JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY=
PSEUDONYM_KEY=

# E-mail sortant (activation de compte, mot de passe oublié, notifications)
SMTP_HOST=smtp.entreprise.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RH Entreprise <rh@entreprise.com>"

# Compte administrateur initial (docker compose exec app node dist/scripts/seed.js)
ADMIN_EMAIL=admin@entreprise.com
ADMIN_PASSWORD=

# Assistant RH optionnel (API compatible OpenAI /v1/completions : LM Studio, Ollama, vLLM...)
LLM_API_URL=
LLM_MODEL=
