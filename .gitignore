# Dépendances et builds
node_modules/
dist/
coverage/

# SECRETS : ne jamais versionner
.env
.env.*
!.env.example
!.env.docker.example
clients/*/.env
*.key

# Données locales
backups/
server/storage/
server/.devdb/
clients/*/storage/
*.log
logs/

__pycache__/
*.pyc

# Divers
.DS_Store
Thumbs.db
.vscode/
.idea/
scratch-keys.txt

# Graphe de connaissances généré (graphify) : se régénère avec `graphify update .`
graphify-out/

# Instances lancées en local (pid, journaux) et colis livrés aux clients
.instances/
ship/

# Secrets Docker générés par npm run secrets:gen
secrets/

# Rapports du scan ZAP
.zap/zap-report.*

# Tests visuels Playwright
client/playwright-report/
client/test-results/

# Copie générée de shared/src pour le serveur (shared/sync.mjs)
server/src/_shared/

# Listes de composants générées (npm run sbom) : jointes aux livraisons, pas au dépôt
sbom/
client/stats.html
