# Copier en .env puis remplir. NE JAMAIS versionner .env.
# Générer les 4 clés : npm run gen:keys

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/humanlink
APP_URL=http://localhost:5173
# Nombre de reverse proxies devant Node (0 = aucun, 1 = Nginx/Caddy/Traefik). Mal réglé, la limitation de débit est contournable.
TRUST_PROXY=0
# Cookies HTTPS uniquement : actif par défaut en production. Ne mettre false que sur un intranet en HTTP.
# COOKIE_SECURE=true

# Secrets en fichier (Docker secrets) : <NOM>_FILE=/run/secrets/<fichier> remplace <NOM>. Voir docs/DEPLOIEMENT.md.
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY=
PSEUDONYM_KEY=
# Rotation sans arrêt : anciennes clés (séparées par des virgules) encore acceptées en lecture, puis `npm run rotate-keys`. Voir docs/SECURITE-RGPD.md.
# FIELD_ENCRYPTION_KEYS_OLD=
# FILE_ENCRYPTION_KEYS_OLD=

# Dossier du client (config + logos). Un dossier par client dans /clients.
CLIENT_DIR=../clients/example

STORAGE_DIR=./storage

# SMTP : sans configuration, les e-mails sont affichés dans la console (dev uniquement)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Human Link <no-reply@example.com>"

# Compte admin initial créé par `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Assistant RH optionnel (API compatible OpenAI /v1/completions)
LLM_API_URL=
LLM_MODEL=

# Antivirus ClamAV (optionnel) : chaque fichier téléversé est analysé avant stockage. Démon : docker compose --profile antivirus up -d clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=false   # true : refuser les fichiers si l'antivirus est injoignable

# Contrôle des mots de passe divulgués (Have I Been Pwned, k-anonymat). Actif par défaut ; false pour un serveur sans accès Internet sortant.
# HIBP_ENABLED=true

# Production : servir le front depuis Node (sinon Nginx/Caddy devant)
SERVE_CLIENT=false
CLIENT_DIST=../client/dist
