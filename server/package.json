{
  "name": "human-link-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "tsx src/scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "gen:keys": "tsx src/scripts/gen-keys.ts",
    "rotate-keys": "tsx src/scripts/rotate-keys.ts",
    "migrate:sqlite": "tsx src/scripts/migrate-from-sqlite.ts",
    "setup": "tsx src/scripts/init-env.ts",
    "sync:shared": "node ../shared/sync.mjs src/_shared",
    "predev": "npm run sync:shared --silent",
    "prebuild": "npm run sync:shared --silent",
    "pretypecheck": "npm run sync:shared --silent",
    "pretest": "npm run sync:shared --silent",
    "gen:openapi": "tsx src/scripts/gen-openapi.ts",
    "pregen:openapi": "npm run sync:shared --silent",
    "e2e:server": "tsx src/scripts/e2e-server.ts",
    "pree2e:server": "npm run sync:shared --silent"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "human-link": "file:..",
    "jose": "^6.2.12",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
