# Variables de docker-compose (fichier .env à la racine, jamais versionné).
MONGO_PASSWORD=changez-moi-avec-un-mot-de-passe-long-et-aleatoire
# Dossier du client à déployer (config + logos + .env)
CLIENT_DIR=./clients/example
# Port exposé par l'application (mettre 127.0.0.1:4000 derrière un reverse proxy)
APP_PORT=4000
# 0 = pas de reverse proxy ; 1 = Caddy/Nginx devant l'application
TRUST_PROXY=0
# Profil https uniquement : nom de domaine public (le DNS doit pointer vers ce serveur)
# DOMAIN=rh.entreprise.com

# Sauvegardes automatiques (docker compose --profile backup up -d backup) : voir docs/DEPLOIEMENT.md
# BACKUP_PATH=./backups              # dossier de l'hôte (idéalement un autre disque ou un montage réseau)
# BACKUP_KEEP_DAYS=14                # durée de conservation
# BACKUP_HOUR=2                      # heure de la sauvegarde nocturne (UTC)
# BACKUP_PASSPHRASE=                 # facultatif : chiffre les sauvegardes (à conserver dans un coffre, séparé)
# ERROR_WEBHOOK_URL=                 # facultatif : prévient l'équipe (Slack, Teams, Mattermost, ntfy…) d'un échec de sauvegarde
