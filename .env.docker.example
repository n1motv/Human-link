# Variables de docker-compose (fichier .env à la racine, jamais versionné).
MONGO_PASSWORD=changez-moi-avec-un-mot-de-passe-long-et-aleatoire
# Dossier du client à déployer (config + logos + .env)
CLIENT_DIR=./clients/example
# Port exposé par l'application (mettre 127.0.0.1:4000 derrière un reverse proxy)
APP_PORT=4000
# 0 = pas de reverse proxy ; 1 = Caddy/Nginx devant l'application
TRUST_PROXY=0
# Profil https uniquement : nom de domaine public (le DNS doit pointer vers ce serveur)
# DOMAIN=rh.entreprise.com
