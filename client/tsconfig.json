{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    // shared/src n'a pas de node_modules : ses types zod se résolvent avec la copie du client.
    "paths": { "@shared": ["../shared/src/index.ts"], "zod": ["./node_modules/zod"] }
  },
  "include": ["src", "vite.config.ts", "../shared/src"]
}
